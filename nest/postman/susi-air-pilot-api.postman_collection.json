{
  "info": {
    "name": "Susi Air Pilot API",
    "description": "REST API for the Susi Air Pilot App technical test.\n\n**Quick start:** open any request and press Send. If there is no token yet, the collection logs in as `johndoe` automatically. You can also run the whole collection with the Runner.\n\n- `baseUrl` points to the live Railway deployment. Change it to `http://localhost:3001` to test a local server.\n- Business logic treats **15 May 2026** as today.\n- Every route except `POST /auth/login` needs `Authorization: Bearer <token>`. This is handled for you at collection level.\n- Errors always look like `{ statusCode, code, message, details? }`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://susi-pilot-app-production.up.railway.app"
    },
    {
      "key": "username",
      "value": "johndoe"
    },
    {
      "key": "password",
      "value": "susiairtest"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Log in automatically when a protected request runs without a token.",
          "const isPublic = pm.request.auth && pm.request.auth.type === 'noauth';",
          "if (!isPublic && !pm.collectionVariables.get('accessToken')) {",
          "  pm.sendRequest({",
          "    url: pm.variables.get('baseUrl') + '/auth/login',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: {",
          "      mode: 'raw',",
          "      raw: JSON.stringify({",
          "        username: pm.variables.get('username'),",
          "        password: pm.variables.get('password'),",
          "      }),",
          "    },",
          "  }, (error, response) => {",
          "    if (!error && response.code === 200) {",
          "      pm.collectionVariables.set('accessToken', response.json().accessToken);",
          "    }",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "description": "Returns a Bearer token valid for 8 hours. The token is saved to `accessToken` for the other requests.",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns an 8-hour Bearer token', () => { pm.expect(body.tokenType).to.eql('Bearer'); pm.expect(body.expiresIn).to.eql(28800); pm.expect(body.accessToken).to.be.a('string'); });",
                  "if (pm.response.code === 200) pm.collectionVariables.set('accessToken', body.accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Pilot",
      "item": [
        {
          "name": "Pilot profile",
          "request": {
            "method": "GET",
            "description": "Name, total flight hours and avatar URL (inline SVG).",
            "url": {
              "raw": "{{baseUrl}}/pilot/me",
              "host": ["{{baseUrl}}"],
              "path": ["pilot", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Profile fields', () => { pm.expect(body.name).to.eql('John Doe'); pm.expect(body.totalFlightHours).to.eql(1444.5); pm.expect(body.avatarUrl).to.match(/^data:image\\/svg\\+xml/); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Flight hours",
      "item": [
        {
          "name": "Daily hours",
          "request": {
            "method": "GET",
            "description": "Daily flight hours between two dates, both inclusive. Dates use `YYYY-MM-DD`.",
            "url": {
              "raw": "{{baseUrl}}/flight-hours?from=2026-05-09&to=2026-05-15",
              "host": ["{{baseUrl}}"],
              "path": ["flight-hours"],
              "query": [
                {
                  "key": "from",
                  "value": "2026-05-09",
                  "description": "Start date, YYYY-MM-DD"
                },
                {
                  "key": "to",
                  "value": "2026-05-15",
                  "description": "End date, YYYY-MM-DD, not before `from`"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Seven days, sorted, ending on 15 May', () => { pm.expect(body.days).to.have.length(7); pm.expect(body.days[6]).to.eql({ date: '2026-05-15', hours: 6.4 }); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Rolling summary",
          "description": "Limit cards for 15 May plus the rolling-sum chart (7 days before to 7 days after today). The rolling sum is calculated on the server.",
          "item": [
            {
              "name": "Summary 1w",
              "request": {
                "method": "GET",
                "description": "Chart uses a 7-day rolling window, limit line 40 h, Y max 45 h.",
                "url": {
                  "raw": "{{baseUrl}}/flight-hours/summary?range=1w",
                  "host": ["{{baseUrl}}"],
                  "path": ["flight-hours", "summary"],
                  "query": [
                    {
                      "key": "range",
                      "value": "1w",
                      "description": "One of 1w, 1m, 3m, 6m, 1y. Defaults to 1w."
                    }
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status 200', () => pm.response.to.have.status(200));",
                      "const body = pm.response.json();",
                      "pm.test('Chart bounds for 1w', () => pm.expect(body.chart).to.include({ windowDays: 7, limit: 40, yMax: 45 }));",
                      "pm.test('15 points centered on 15 May', () => { pm.expect(body.chart.points).to.have.length(15); pm.expect(body.chart.points[7].date).to.eql('2026-05-15'); });",
                      "pm.test('Four limit cards for today', () => pm.expect(body.cards.map((c) => c.period)).to.eql(['daily', 'weekly', 'monthly', 'annual']));"
                    ]
                  }
                }
              ]
            },
