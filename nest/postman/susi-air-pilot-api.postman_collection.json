            "url": {
              "raw": "{{baseUrl}}/schedules?year=2026&month=05",
              "host": ["{{baseUrl}}"],
              "path": ["schedules"],
              "query": [
                {
                  "key": "year",
                  "value": "2026",
                  "description": "Four-digit year"
                },
