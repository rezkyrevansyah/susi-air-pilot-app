    {
      "name": "Documents",
      "item": [
        {
          "name": "Documents",
          "request": {
            "method": "GET",
            "description": "Pilot documents with days remaining and a badge status: `safe`, `soon` (30 days or less) or `expired`.",
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": ["{{baseUrl}}"],
              "path": ["documents"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const docs = pm.response.json().documents;",
                  "pm.test('Badge status per document', () => pm.expect(Object.fromEntries(docs.map((d) => [d.id, d.status]))).to.eql({ doc_recurrent: 'safe', doc_ppc: 'safe', doc_license: 'soon', doc_medical: 'soon', doc_security: 'expired' }));"
                ]
              }
            }
          ]
        }
      ]
    },
