    {
      "name": "Error cases",
      "description": "Examples of the shared error response shape.",
      "item": [
        {
          "name": "Login with wrong password",
          "request": {
            "method": "POST",
            "description": "Bad credentials return 401 `INVALID_CREDENTIALS`.",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 INVALID_CREDENTIALS with the standard error shape', () => { pm.response.to.have.status(401); const body = pm.response.json(); pm.expect(body).to.include({ statusCode: 401, code: 'INVALID_CREDENTIALS' }); pm.expect(body.message).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing token",
          "request": {
            "method": "GET",
            "description": "A protected route without a token returns 401 `UNAUTHORIZED`.",
            "url": {
              "raw": "{{baseUrl}}/pilot/me",
              "host": ["{{baseUrl}}"],
              "path": ["pilot", "me"]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 UNAUTHORIZED with the standard error shape', () => { pm.response.to.have.status(401); const body = pm.response.json(); pm.expect(body).to.include({ statusCode: 401, code: 'UNAUTHORIZED' }); pm.expect(body.message).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid range",
          "request": {
            "method": "GET",
            "description": "An unknown `range` returns 400 `VALIDATION_ERROR` with details.",
            "url": {
              "raw": "{{baseUrl}}/flight-hours/summary?range=2w",
              "host": ["{{baseUrl}}"],
              "path": ["flight-hours", "summary"],
              "query": [
                {
                  "key": "range",
                  "value": "2w",
                  "description": "Not an allowed value"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 VALIDATION_ERROR with the standard error shape', () => { pm.response.to.have.status(400); const body = pm.response.json(); pm.expect(body).to.include({ statusCode: 400, code: 'VALIDATION_ERROR' }); pm.expect(body.message).to.be.a('string'); });",
                  "pm.test('Lists what was wrong', () => pm.expect(pm.response.json().details).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid month",
