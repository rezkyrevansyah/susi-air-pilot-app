{
  "name": "susi-air-pilot-api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:e2e": "vitest run test",
    "format:check": "prettier --check src test *.json *.ts *.md postman",
    "check": "npm run typecheck && npm run test && npm run build && node test/production-smoke.mjs",
    "test:production": "npm run build && node test/production-smoke.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.1.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.3",
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "unplugin-swc": "^2.0.0",
    "@swc/core": "^1.15.0"
  },
  "type": "module"
}
